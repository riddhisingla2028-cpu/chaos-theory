# Copy to .env.local for local builds, or set these in your host's dashboard. All optional.
# VITE_ values are PUBLIC (they are built into the browser code). Never put a secret in one.

# Chaos+ purchases (all three needed; otherwise the page shows "Coming soon")
VITE_CHAOSPLUS_CHECKOUT_URL=
VITE_CHAOSPLUS_PRICE=
VITE_SUPPORT_EMAIL=
# Server-only (read by functions/api/verify-license.ts and the dev server). Not a VITE_ variable.
GUMROAD_PRODUCT_ID=

# Analytics (optional, cookieless)
VITE_UMAMI_WEBSITE_ID=

# Accounts and cloud saves (optional). The anon key is public by design; never use the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ad placeholders ("Your brand here") show on menu screens; set to false to hide them all.
VITE_AD_PLACEHOLDERS=true
# Optional: shows an "Advertise with us" link on the placeholders. Only set a real, monitored inbox.
VITE_ADVERTISE_EMAIL=

# Real ads stay off until a provider is approved and implemented (see src/monetization/ads.ts).
VITE_ADS_ENABLED=false
