# Copy to .env.local and fill in to enable accounts and cloud saves (optional).
# Both values are PUBLIC: the anon key is meant for browsers and is limited by row-level security.
# Never put the service-role key in any VITE_ variable or anywhere in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ads stay off until a provider is approved and implemented (see src/monetization/ads.ts).
VITE_ADS_ENABLED=false
